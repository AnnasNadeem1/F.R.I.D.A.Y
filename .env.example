# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=

# ElevenLabs voice (optional; free plan has a small monthly quota)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Yahoo Mail (app password from Yahoo Account Security -> Generate app password)
YAHOO_EMAIL=
YAHOO_APP_PASSWORD=

# Optional overrides
# ASSISTANT_NAME=Friday
# BRIEFING_TIME=07:30          # speak the daily briefing automatically at this time (empty = only when asked)
# BRIEFING_LOCATION=Islamabad  # city for the briefing's weather
# PLAN_TIME=08:30             # Friday plans your day aloud at this time (empty = only when you ask)
# CHECKIN_TIME=21:30          # evening check-in: how the day went against the plan (empty = only when asked)
# STUDY_GOAL_MINUTES=120      # focus time per day that the plan and check-in aim for
# DISTRACTION_WATCH=1         # during focus sessions, nag when YouTube/games etc. (see distractions.txt) are in front
# STUDY_HOURS=20:00-22:00     # also watch outside focus sessions in these hours (comma-separate several ranges)
# STUDY_STREAK_MINUTES=25     # minutes of focus in a day that count toward your streak
# CLAUDE_TASKS=1               # voice-launched Claude Code tasks (0 = off)
# CLAUDE_PROJECTS=jarvis=C:\jarvis;fedcard=C:\fedcard   # folders Claude may be pointed at
# CLAUDE_TASK_MODEL=sonnet     # sonnet | haiku | opus
# CLAUDE_TASK_MINUTES=10       # a task is stopped after this long
# WAKE_MODEL=                  # .onnx in models/openwakeword; empty = pick by name
# WAKE_REQUIRE_PAUSE=1         # ignore the name mid-sentence
# BARGE_IN=1                   # say the name while she talks to interrupt
# LLM_PROVIDER=gemini          # gemini | groq
# GEMINI_MODEL=gemini-flash-lite-latest   # gemini-flash-latest is smarter but only ~5 requests/min free
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL_BACKUP=openai/gpt-oss-20b   # third fallback with its own rate limit (empty = off)
# STT_ENGINE=groq              # groq (accurate with accents; voice clips go to Groq) | local (stays on this PC)
# WHISPER_MODEL=auto           # auto (small.en on GPU, base.en on CPU) | tiny.en | base.en | small.en
# TTS_ENGINE=elevenlabs        # elevenlabs | kokoro | piper | sapi
# ELEVENLABS_MODEL=eleven_multilingual_v2
# KOKORO_VOICE=bm_george       # local voice / ElevenLabs backup; a mix works too: af_bella:3,af_heart:1
# KOKORO_PAUSE_CAP=0.16       # longest pause kept at a comma, in seconds (0 = leave Kokoro's own pauses)
# KOKORO_MODEL=int8            # int8 (compressed, faster) | fp32 (full quality, a bit slower)
# PIPER_VOICE=en_GB-alan-medium
# WAKE_THRESHOLD=0.5           # lower = wakes more easily (and more false wakes)
# FOLLOWUP_SECONDS=6           # after replying, listen this long for a follow-up without the wake word
# TTS_SPEED=1.1                # higher = slower, clearer (1.0 = voice default)
